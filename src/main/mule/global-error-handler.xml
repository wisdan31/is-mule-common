			<set-variable value="400" doc:name="httpStatus" doc:id="bd2d8fc2-51ec-4b9b-aec8-e83ecb56c3d9" variableName="httpStatus"/>
			<ee:transform doc:name="Transform Message" doc:id="b0bb849b-650c-4300-96fb-c3b881025e61" >
				<ee:message >
					<ee:set-payload ><![CDATA[%dw 2.0
output application/json
import modules::ErrorUtils
---
if (error.errorMessage.payload != null)
    ErrorUtils::getStructureFromPayload(error.errorMessage.payload, vars.httpStatus)
else
    ErrorUtils::getErrorStructure(error, null)]]></ee:set-payload>
				</ee:message>
			</ee:transform>
